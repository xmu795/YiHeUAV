<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <BehaviorTree ID = "TakeoffTaskTree">
        <!--
        整个行为树由一个Logical ROS2 Node托管，Logical ROS2 Node的职责是运行BT Tree
        主任务：起飞至指定高度
        执行顺序：
        1. 输入起飞命令
        2. 检查MavLink连接、D435i相机和激光雷达
        3. 起飞至10米高度
        4. 等待输入命令
        5. 输入降落命令
        6. 降落
        -->
            <Fallback name="DroneDecisionLogic">            
                <Sequence name= "TakeOffSequence">
                    <IsOnGround name="CheckIfOnGround"/>
                    <PublishStatus topic_name="drone/status" status="TAKEOFF"/>
                    <MoveToTarget target_point = "{target_point}"/>
                    <UpdateTimestamp timestamp_output="{last_activity_time}"/>
                    <PublishStatus topic_name="drone/status" status="HOVER"/>
                </Sequence>
                <Sequence name="LandingSequence">
                    <PublishStatus topic_name="drone/status" status="LAND"/>
                    <Land/>
                    <PublishStatus topic_name="drone/status" status="ON_GROUND"/>
                </Sequence>
                <Sequence name="TimeoutLandingRoutine">
                    <IsInAir name="CheckIfInAir"/>
                    <IsTimeoutReached timeout_ms="30000" start_time="{last_activity_time}"/>
                    <PrintMessage message="[AUTO] Timeout reached! Landing automatically."/>
                    <PublishStatus topic_name="drone/status" status="LAND"/>
                    <Land/>
                    <PublishStatus topic_name="drone/status" status="ON_GROUND"/>
                </Sequence>
                <Sequence name="HoveringRoutine">
                    <IsInAir/>
                    <AlwaysSuccess name="Hovering"/>
                </Sequence>
                <AlwaysSuccess name="OnGround"/>
            </Fallback>
        </BehaviorTree>
</root>
