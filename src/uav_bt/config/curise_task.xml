<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <BehaviorTree ID = "CruiseTaskTree">
        <!--
        整个行为树由一个Logical ROS2 Node托管，Logical ROS2 Node的职责是运行BT Tree
        主任务：通过避障，向三个目标航点巡航，释放货物后返航
        执行顺序：
        1. 起飞
        2. 避障巡航至第一个目标航点
        3. 释放货物
        4. 避障巡航至第二个目标航点
        5. 释放货物
        6. 避障巡航至第三个目标航点
        7. 释放货物
        8. 避障巡航返航
        9. 降落
        -->
            <Fallback name="DroneDecisionLogic">            
                <Sequence name= "TakeOffSequence">
                    <IsOnGround name="CheckIfOnGround"/>
                    <PublishStatus topic_name="drone/status" status="TAKEOFF"/>
                    <MoveToTarget target_point = "{target_point}"/>
                    <UpdateTimestamp timestamp_output="{last_activity_time}"/>
                    <PublishStatus topic_name="drone/status" status="HOVER"/>
                </Sequence>
                <Sequence name="CruiseToFirstWaypoint">
                    <PublishStatus topic_name="drone/status" status="CRUISE_TO_FIRST_WAYPOINT"/>
                    <MoveToTarget target_point="{first_waypoint}"/>
                    <PublishStatus topic_name="drone/status" status="RELEASE_CARGO"/>
                    <ReleaseCargo Cargo_id="{first_cargo_id}"/>
                    <PublishStatus topic_name="drone/status" status="HOVER"/>
                </Sequence>
                <Sequence name="CruiseToSecondWaypoint">
                    <PublishStatus topic_name="drone/status" status="CRUISE_TO_SECOND_WAYPOINT"/>
                    <MoveToTarget target_point="{second_waypoint}"/>
                    <PublishStatus topic_name="drone/status" status="RELEASE_CARGO"/>
                    <ReleaseCargo Cargo_id="{second_cargo_id}"/>
                    <PublishStatus topic_name="drone/status" status="HOVER"/>
                </Sequence>
                <Sequence name="CruiseToThirdWaypoint">
                    <PublishStatus topic_name="drone/status" status="CRUISE_TO_THIRD_WAYPOINT"/>
                    <MoveToTarget target_point="{third_waypoint}"/>
                    <PublishStatus topic_name="drone/status" status="RELEASE_CARGO"/>
                    <ReleaseCargo Cargo_id="{third_cargo_id}"/>
                    <PublishStatus topic_name="drone/status" status="HOVER"/>
                </Sequence>
                <Sequence name="ReturnToBase">
                    <PublishStatus topic_name="drone/status" status="RETURN_TO_BASE"/>
                    <MoveToTarget target_point="{base_location}"/>
                    <PublishStatus topic_name="drone/status" status="LAND"/>
                    <Land/>
                    <PublishStatus topic_name="drone/status" status="ON_GROUND"/>
                </Sequence>
            </Fallback>
        </BehaviorTree>
</root>
